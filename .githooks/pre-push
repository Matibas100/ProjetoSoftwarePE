#!/bin/sh

set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON=""

for candidate in ".venv/Scripts/python.exe" ".venv/bin/python" python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -m coverage --version >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "Pre-push bloqueado: Python com as dependências de teste não encontrado." >&2
    echo "Execute: python -m pip install -r backend/requirements-dev.txt" >&2
    exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
    echo "Pre-push bloqueado: npm não encontrado." >&2
    exit 1
fi

echo "Pre-push: executando testes e cobertura do backend..."
RUN_MYSQL_INTEGRATION=1 "$PYTHON" backend/tests/run_backend_coverage.py

echo "Pre-push: executando testes e cobertura do frontend..."
npm run test:coverage

echo "Pre-push: todos os testes foram aprovados."
