# Aplicacao Flask
FLASK_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=5000

# Origens autorizadas a consumir /api/*, separadas por virgula
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# MySQL - copie este arquivo para .env e substitua os exemplos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plataforma_enem
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_CHARSET=utf8mb4

# Alternativa: uma URL completa substitui as variaveis DB_* acima.
# DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/plataforma_enem?charset=utf8mb4

# Autenticacao escolar: gere 32 bytes aleatorios (64 caracteres hexadecimais).
AUTH_SECRET_KEY=
# Use true somente em HTTPS; desenvolvimento HTTP local usa false.
AUTH_COOKIE_SECURE=false
